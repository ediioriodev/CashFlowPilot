# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ma il template senza segreti va versionato
!.env.example

# dossier: temporanei e backup (le emissioni *_v*.html vanno versionate)
docs/dossier/*.bak
docs/dossier/*.tmp
docs/roadmap/*.bak
docs/roadmap/*.tmp

# MCP di progetto: contiene solo il project-ref (pubblico), ma il file
# e' locale alla macchina e dipende da SUPABASE_ACCESS_TOKEN nell'ambiente
.mcp.json
